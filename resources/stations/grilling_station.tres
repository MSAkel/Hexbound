[sub_resource type="Resource" id="capstone_0"]
script = ExtResource("s_pan_drippings")
description = "Pan Drippings: each Meat Meal served here gives a {garnish} to a Sauce & Dip Meal on an adjacent Sauce Station"

[sub_resource type="Resource" id="capstone_1"]
script = ExtResource("s_level_spill")
description = "Charred Vegetables: Vegetables on an adjacent Cold Station also gain this station's level {flavour}"
target_tags = Array[StringName]([&"vegetable"])
partner_type_id = "cold_station"

[resource]
script = ExtResource("1_type")
id = "grilling_station"
display_name = "Grilling Station"
icon = ExtResource("3_icon")
color = Color(1, 0.48, 0.2, 1)
required_counts = {
&"meat": 2,
&"seasoning": 1,
&"kitchenware": 1
}
distinct_tags = Array[StringName]([&"meat"])
required_card_ids = Array[String]([])
level_perks = Array[ExtResource("2_perk")]([SubResource("level_1"), SubResource("level_2"), SubResource("level_3"), SubResource("level_4"), SubResource("level_5"), SubResource("level_6")])
choice_options = Array[ExtResource("2_perk")]([SubResource("choice_0"), SubResource("choice_1")])
capstone_options = Array[ExtResource("2_perk")]([SubResource("capstone_0"), SubResource("capstone_1")])
