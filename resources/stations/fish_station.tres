[sub_resource type="Resource" id="capstone_1"]
script = ExtResource("s_surf_and_turf")
description = "Surf & Turf: Seafood Meals on this station gain x1.5 output while a Meat Meal is being served on a Grilling Station"
output_scale = 1.5

[resource]
script = ExtResource("1_type")
