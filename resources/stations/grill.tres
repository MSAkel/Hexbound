[gd_resource type="Resource" script_class="StationType" format=3 uid="uid://bvvhsxitbrihv"]

[ext_resource type="Script" uid="uid://rpgwnpjas3xh" path="res://scripts/resources/station_type.gd" id="1_type"]
[ext_resource type="Script" uid="uid://dsqcvvw2je1ns" path="res://scripts/resources/station_perk.gd" id="2_perk"]
[ext_resource type="Texture2D" uid="uid://bcq5x3x5nr1ro" path="res://assets/icons/food/ingredients/meats/steak.png" id="3_icon"]

[sub_resource type="Resource" id="choice_steak"]
script = ExtResource("2_perk")
description = "Steak {flavour} on this station is tripled"
target_card_ids = Array[String](["steak"])
output_scale = 3.0

[sub_resource type="Resource" id="choice_meats"]
script = ExtResource("2_perk")
description = "All Meats on this station gain +10 {flavour}"
target_tags = Array[StringName]([&"protein"])
flat_flavour = 10

[sub_resource type="Resource" id="perk_l1"]
script = ExtResource("2_perk")
description = "Meats on this station gain +10 {flavour}"
target_tags = Array[StringName]([&"protein"])
flat_flavour = 10

[sub_resource type="Resource" id="perk_l2"]
script = ExtResource("2_perk")
description = "Meats on this station gain +15 {flavour}"
target_tags = Array[StringName]([&"protein"])
flat_flavour = 15

[sub_resource type="Resource" id="perk_l4"]
script = ExtResource("2_perk")
description = "Meats on this station gain +20 {flavour}"
target_tags = Array[StringName]([&"protein"])
flat_flavour = 20

[resource]
script = ExtResource("1_type")
id = "grill"
display_name = "Grilling Station"
icon = ExtResource("3_icon")
color = Color(1, 0.48, 0.2, 1)
required_counts = {
&"kitchenware": 1,
&"protein": 2,
&"seasoning": 1
}
distinct_tags = Array[StringName]([&"protein"])
level_perks = Array[ExtResource("2_perk")]([SubResource("perk_l1"), SubResource("perk_l2"), SubResource("perk_l2"), SubResource("perk_l4")])
choice_options = Array[ExtResource("2_perk")]([SubResource("choice_steak"), SubResource("choice_meats")])
