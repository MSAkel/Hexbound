[gd_resource type="Resource" script_class="StationType" format=3]

[ext_resource type="Script" path="res://scripts/resources/station_type.gd" id="1_type"]
[ext_resource type="Script" path="res://scripts/resources/station_perk.gd" id="2_perk"]
[ext_resource type="Texture2D" uid="uid://dqebk6odvlao0" path="res://assets/icons/food/ingredients/proteins/shrimp.png" id="3_icon"]

[sub_resource type="Resource" id="perk_l1"]
script = ExtResource("2_perk")
description = "Seafood on this station gain +10 {flavour}"
target_tags = Array[StringName]([&"seafood"])
flat_flavour = 10

[sub_resource type="Resource" id="perk_l2"]
script = ExtResource("2_perk")
description = "Seafood on this station gain +15 {flavour}"
target_tags = Array[StringName]([&"seafood"])
flat_flavour = 15

[sub_resource type="Resource" id="perk_l4"]
script = ExtResource("2_perk")
description = "Seafood on this station gain +20 {flavour}"
target_tags = Array[StringName]([&"seafood"])
flat_flavour = 20

[sub_resource type="Resource" id="choice_card"]
script = ExtResource("2_perk")
description = "Lobster output on this station is doubled"
target_card_ids = Array[String](["lobster"])
output_scale = 2.0

[sub_resource type="Resource" id="choice_kinds"]
script = ExtResource("2_perk")
description = "Seafood and Fruits on this station gain +10 {flavour}"
target_tags = Array[StringName]([&"seafood", &"fruit"])
flat_flavour = 10

[resource]
script = ExtResource("1_type")
id = "raw_bar"
display_name = "Raw Bar"
icon = ExtResource("3_icon")
color = Color(0.2, 0.62, 0.86, 1)
required_counts = {
&"seafood": 2,
&"fruit": 1,
&"kitchenware": 1
}
distinct_tags = Array[StringName]([&"seafood"])
level_perks = Array[ExtResource("2_perk")]([SubResource("perk_l1"), SubResource("perk_l2"), SubResource("perk_l2"), SubResource("perk_l4")])
choice_options = Array[ExtResource("2_perk")]([SubResource("choice_card"), SubResource("choice_kinds")])
