[sub_resource type="Resource" id="level_1"]
script = ExtResource("s_per_hour_flat")
description = "Meats and Vegetables on this station gain +3 {flavour} for each Hour played today."
target_tags = Array[StringName]([&"meat", &"vegetable"])
per_hour = 3

[sub_resource type="Resource" id="level_2"]
script = ExtResource("s_per_hour_flat")
description = "Meats and Vegetables on this station gain +3 {flavour} for each Hour played today. Meats and Vegetables appear twice as often in card picks and at the merchant."
target_tags = Array[StringName]([&"meat", &"vegetable"])
per_hour = 3
draw_tags = Array[StringName]([&"meat", &"vegetable"])
draw_meal_categories = Array[int]([])
draw_weight = 2.0

