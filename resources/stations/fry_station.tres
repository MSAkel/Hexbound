[sub_resource type="Resource" id="level_1"]
script = ExtResource("2_perk")
description = "All Ingredients on this station gain +3 {flavour}."
target_tags = Array[StringName]([&"vegetable", &"fruit", &"meat", &"seafood", &"dairy", &"sweet", &"seasoning"])
flat_flavour = 3

