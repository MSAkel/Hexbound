target_tags = Array[StringName]([&"seafood", &"vegetable"])

[sub_resource type="Resource" id="capstone_0"]
script = ExtResource("s_fish_and_chips")
description = "Fish & Chips: while a Fish Station is adjacent, Seafood Meals on this station also count as Sides"

[sub_resource type="Resource" id="capstone_1"]
script = ExtResource("s_pub_grub")
description = "Pub Grub: each Ingredient {trigger} here gives every Beer on a Bar +x0.05 {mult} for the rest of the Day"
xmult_per_trigger = 0.05

[resource]
script = ExtResource("1_type")
id = "fry_station"
display_name = "Fry Station"
icon = ExtResource("3_icon")
color = Color(0.95, 0.75, 0.25, 1)
required_counts = {
&"ingredient": 3
}
distinct_tags = Array[StringName]([&"ingredient"])
required_card_ids = Array[String](["deep_fryer"])
level_perks = Array[ExtResource("2_perk")]([SubResource("level_1"), SubResource("level_2"), SubResource("level_3"), SubResource("level_4"), SubResource("level_5"), SubResource("level_6")])
choice_options = Array[ExtResource("2_perk")]([SubResource("choice_0"), SubResource("choice_1")])
capstone_options = Array[ExtResource("2_perk")]([SubResource("capstone_0"), SubResource("capstone_1")])
