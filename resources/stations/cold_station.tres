[gd_resource type="Resource" script_class="StationType" format=3]

[ext_resource type="Script" path="res://scripts/resources/station_type.gd" id="1_type"]
[ext_resource type="Script" path="res://scripts/resources/station_perk.gd" id="2_perk"]
[ext_resource type="Texture2D" uid="uid://vhgfidc52ks6" path="res://assets/icons/food/meals/dishes/salad.png" id="3_icon"]

[sub_resource type="Resource" id="perk_l1"]
script = ExtResource("2_perk")
description = "Vegetables on this station gain +10 {flavour}"
target_tags = Array[StringName]([&"vegetable"])
flat_flavour = 10

[sub_resource type="Resource" id="perk_l2"]
script = ExtResource("2_perk")
description = "Vegetables on this station gain +15 {flavour}"
target_tags = Array[StringName]([&"vegetable"])
flat_flavour = 15

[sub_resource type="Resource" id="perk_l4"]
script = ExtResource("2_perk")
description = "Vegetables on this station gain +20 {flavour}"
target_tags = Array[StringName]([&"vegetable"])
flat_flavour = 20

[sub_resource type="Resource" id="choice_salad"]
script = ExtResource("2_perk")
description = "Salad output on this station is doubled"
target_card_ids = Array[String](["salad"])
output_scale = 2.0

[sub_resource type="Resource" id="choice_produce"]
script = ExtResource("2_perk")
description = "Fruits and Vegetables on this station gain +10 {flavour}"
target_tags = Array[StringName]([&"vegetable", &"fruit"])
flat_flavour = 10

[resource]
script = ExtResource("1_type")
id = "cold_station"
display_name = "Cold Station"
icon = ExtResource("3_icon")
color = Color(0.45, 0.82, 1, 1)
required_counts = {
&"vegetable": 2,
&"fruit": 1,
&"kitchenware": 1
}
distinct_tags = Array[StringName]([&"vegetable"])
level_perks = Array[ExtResource("2_perk")]([SubResource("perk_l1"), SubResource("perk_l2"), SubResource("perk_l2"), SubResource("perk_l4")])
choice_options = Array[ExtResource("2_perk")]([SubResource("choice_salad"), SubResource("choice_produce")])
