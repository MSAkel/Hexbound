class_name CardKeywordGlossary
extends RefCounted

## Keyword wording, colour and hover-tooltip copy for player-facing text.
## Text refers to a keyword with a {token}. Base words come from GameTerms.
## Inflected forms are written out next to them in _static_init.

class Keyword:
	var id: StringName
	## Token name -> displayed word. The first entry is the keyword's display name.
	var forms: Dictionary
	var display_name: String
	## Empty tooltip means the word is colored but does not spawn a hover panel.
	var tooltip: String

	func _init(
		p_id: StringName,
		p_forms: Dictionary,
		p_tooltip: String = ""
	) -> void:
		id = p_id
		tooltip = p_tooltip
		set_forms(p_forms)


	func set_forms(p_forms: Dictionary) -> void:
		forms = p_forms
		display_name = "" if forms.is_empty() else String(forms.values()[0])


static var _keywords: Array[Keyword] = []
static var _token_to_keyword: Dictionary = {}
static var _token_regex: RegEx = null
## Unknown tokens already reported, so a typo warns once instead of every frame.
static var _warned_tokens: Dictionary = {}

## Every keyword is drawn in this one colour.
const COLOR := Color("#2e855c")

# Every form is a whole written-out word (no STATION + "s"), so each one can
# become its own translation key later.
static func _static_init() -> void:
	register(
		"flavour",
		{"flavour": GameTerms.FLAVOUR},
		"Resource Generated by Ingredient cards."
	)
	register(
		"mult",
		{"mult": GameTerms.MULT},
		"Multiplies {flavour} in the same {station}."
	)
	register(
		"garnish",
		{"garnish": GameTerms.GARNISH, "garnishes": "Garnishes", "garnished": "Garnished"},
		"A {garnished} card has x%d output for the rest of the Hour. Stacks up to %d times." % [
			int(TileCard.GARNISH_OUTPUT_SCALE),
			TileCard.MAX_GARNISH_STACKS,
		]
	)
	register(
		"following",
		{"following": GameTerms.FOLLOWING},
		"Later in this {station}'s {trigger} order."
	)
	register(
		"spoil",
		{"spoil": GameTerms.SPOIL, "spoils": "Spoils", "spoiled": "Spoiled"},
		"Remove the card."
	)
	register(
		"trigger",
		{
			"trigger": GameTerms.TRIGGER,
			"triggers": "Triggers",
			"triggered": "Triggered",
			"retrigger": "Retrigger",
			"retriggers": "Retriggers",
		},
		"Activate the card."
	)
	register(
		"station",
		{"station": GameTerms.STATION, "stations": "Stations"},
		"A row of 8 spots. The last 2 are reserved for Meals."
	)
	register(
		"liquefy",
		{"liquefy": GameTerms.LIQUEFY, "liquefies": "Liquefies"},
		"Coming soon."
	)

static func register(
	id: StringName,
	forms: Dictionary,
	tooltip: String = ""
) -> void:
	for existing: Keyword in _keywords:
		if existing.id == id:
			existing.set_forms(forms)
			existing.tooltip = tooltip
			_rebuild_token_index()
			return

	_keywords.append(Keyword.new(id, forms, tooltip))
	_rebuild_token_index()


## Tokens become their colored display word. For RichTextLabels.
static func to_bbcode(source: String) -> String:
	var result := ""
	var cursor := 0
	for regex_match: RegExMatch in _find_tokens(source):
		result += _escape_bbcode(source.substr(cursor, regex_match.get_start() - cursor))
		var token := regex_match.get_string(1)
		var keyword := find_keyword(token)
		if keyword == null:
			_warn_unknown_token(token, source)
			result += _escape_bbcode(regex_match.get_string())
		else:
			result += "[color=#%s]%s[/color]" % [
				COLOR.to_html(false),
				_escape_bbcode(String(keyword.forms[token])),
			]
		cursor = regex_match.get_end()

	result += _escape_bbcode(source.substr(cursor))
	return result


## Tokens become their display word with no markup. For Labels and plain tooltips.
static func to_plain(source: String) -> String:
	var result := ""
	var cursor := 0
	for regex_match: RegExMatch in _find_tokens(source):
		result += source.substr(cursor, regex_match.get_start() - cursor)
		var token := regex_match.get_string(1)
		var keyword := find_keyword(token)
		if keyword == null:
			_warn_unknown_token(token, source)
			result += regex_match.get_string()
		else:
			result += String(keyword.forms[token])
		cursor = regex_match.get_end()

	result += source.substr(cursor)
	return result


## Unique keywords that have tooltip copy, in first-appearance order.
static func tooltip_entries(source: String) -> Array[Dictionary]:
	var entries: Array[Dictionary] = []
	var seen := {}
	for regex_match: RegExMatch in _find_tokens(source):
		var keyword := find_keyword(regex_match.get_string(1))
		if keyword == null:
			continue
		if keyword.tooltip.is_empty():
			continue
		if seen.has(keyword.id):
			continue
		seen[keyword.id] = true
		entries.append({
			"id": keyword.id,
			"title": keyword.display_name,
			"text": "%s\n%s" % [keyword.display_name, to_plain(keyword.tooltip)],
		})

	return entries


static func find_keyword(token: String) -> Keyword:
	return _token_to_keyword.get(token) as Keyword


## Rebuilds the token map after register.
static func _rebuild_token_index() -> void:
	_token_to_keyword.clear()
	for keyword: Keyword in _keywords:
		for token: String in keyword.forms:
			_token_to_keyword[token] = keyword


static func _find_tokens(source: String) -> Array[RegExMatch]:
	if source.is_empty():
		return []
	if _token_regex == null:
		_token_regex = RegEx.new()
		_token_regex.compile("\\{([a-z_]+)\\}")
	return _token_regex.search_all(source)


# Left as written on screen, so a typo is visible in-game as well as in the log.
static func _warn_unknown_token(token: String, source: String) -> void:
	if _warned_tokens.has(token):
		return
	_warned_tokens[token] = true
	push_warning("CardKeywordGlossary: unknown token {%s} in \"%s\"." % [token, source])


static func _escape_bbcode(text: String) -> String:
	return text.replace("[", "[lb]")
