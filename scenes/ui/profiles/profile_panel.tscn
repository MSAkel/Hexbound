[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/profiles/profile_panel.gd" id="1_panel"]
[ext_resource type="PackedScene" path="res://scenes/ui/profiles/profile_slot_card.tscn" id="2_card"]
[ext_resource type="PackedScene" path="res://scenes/ui/profiles/profile_confirm_panel.tscn" id="3_confirm"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_dim"]
bg_color = Color(0.050708726, 0.09320182, 0.09985284, 0.56600004)

[node name="ProfilePanel" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_dim")
script = ExtResource("1_panel")

[node name="Parchment" type="PanelContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
theme_type_variation = &"ParchmentPanel"

[node name="VBoxContainer" type="VBoxContainer" parent="Parchment"]
layout_mode = 2
theme_override_constants/separation = 32

[node name="Title" type="Label" parent="Parchment/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 64
text = "Profiles"
horizontal_alignment = 1

[node name="SlotRow" type="HBoxContainer" parent="Parchment/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 28
alignment = 1

[node name="Slot1" parent="Parchment/VBoxContainer/SlotRow" instance=ExtResource("2_card")]
layout_mode = 2

[node name="Slot2" parent="Parchment/VBoxContainer/SlotRow" instance=ExtResource("2_card")]
layout_mode = 2

[node name="Slot3" parent="Parchment/VBoxContainer/SlotRow" instance=ExtResource("2_card")]
layout_mode = 2

[node name="CloseButton" type="Button" parent="Parchment/VBoxContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 40)
layout_mode = 2
size_flags_horizontal = 4
theme_type_variation = &"ConfirmButton"
text = "Close"

[node name="ProfileConfirmPanel" parent="." instance=ExtResource("3_confirm")]
unique_name_in_owner = true
visible = false
layout_mode = 2

[connection signal="pressed" from="Parchment/VBoxContainer/CloseButton" to="." method="_on_close_button_pressed"]
